{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"declaration": false,
		"sourceMap": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/application/use-cases/**/*.test.ts"]
}
