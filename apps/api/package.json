{
	"name": "@strokecare/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=../../.env src/main.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && echo dist ready",
		"start": "node --env-file=../../.env dist/main.js",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=../../.env src/infrastructure/db/seed.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.0",
		"@orpc/server": "^1.14.0",
		"better-auth": "^1.1.0",
		"drizzle-orm": "^0.39.0",
		"hono": "^4.6.0",
		"ioredis": "^5.4.0",
		"pg": "^8.13.0",
		"pino": "^9.5.0",
		"ts-pattern": "^5.5.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/pg": "^8.11.10",
		"drizzle-kit": "^0.30.0",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
