# Database connection string (PostgreSQL)
DATABASE_URL="postgres://postgres:password@localhost:5432/stroke_ai"
REDIS_URL="redis://127.0.0.1:6379"
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:5173"
PORT="3001"
NODE_ENV="development"
VITE_API_URL="http://localhost:3001"

# OpenRouter powers AI companion responses.
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional SSO providers. Leave empty to hide the provider in the login UI.
# OAuth callback URLs for local development:
# Google: http://localhost:3001/api/auth/callback/google
# GitHub: http://localhost:3001/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
