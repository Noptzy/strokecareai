# Database connection string (PostgreSQL)
DATABASE_URL="postgres://postgres:password@localhost:5432/stroke_ai"

# Redis connection string
REDIS_URL="redis://127.0.0.1:6379"

# Better Auth Secret (Use a strong random string in production)
BETTER_AUTH_SECRET="generate_a_strong_secret_key_here"

# The URL where your backend API is running
BETTER_AUTH_URL="http://localhost:3001"

# The URL where your frontend is running (used for CORS and cookies)
WEB_ORIGIN="http://localhost:5173"

# Port for the backend API
PORT="3001"

# Environment (development, test, production)
NODE_ENV="development"

# API URL referenced by the Vite frontend
VITE_API_URL="http://localhost:3001"

# Optional SSO providers. Leave empty to hide the provider in the login UI.
# OAuth callback URLs for local development:
# Google: http://localhost:3001/api/auth/callback/google
# GitHub: http://localhost:3001/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
